# Local development credentials matching compose.yaml; not production credentials.
ARCADEDB_URL=http://localhost:2480
ARCADEDB_USERNAME=root
ARCADEDB_PASSWORD=arcadedb-test-password
# Created by the Compose server's defaultDatabases setting on startup.
ARCADEDB_DATABASE=better_auth
BETTER_AUTH_URL=http://localhost:3000
# Replace with a random secret before using the example (see examples/basic/README.md).
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
