{
  "name": "better-auth-arcadedb",
  "version": "0.1.0",
  "description": "ArcadeDB database adapter for Better Auth using the official HTTP driver.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevSnap/better-auth-arcadedb.git"
  },
  "homepage": "https://github.com/DevSnap/better-auth-arcadedb#readme",
  "bugs": {
    "url": "https://github.com/DevSnap/better-auth-arcadedb/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "lint:package": "publint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:package": "node scripts/smoke-package.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version:packages": "changeset version && pnpm install --lockfile-only && pnpm format",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@arcadedb/driver": "~0.3.0",
    "better-auth": "~1.7.10"
  },
  "devDependencies": {
    "@arcadedb/driver": "0.3.0",
    "@better-auth/test-utils": "1.7.10",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "better-auth": "1.7.10",
    "publint": "^0.3.25",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsdown": "0.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "better-auth",
    "arcadedb",
    "adapter",
    "authentication",
    "typescript"
  ]
}
